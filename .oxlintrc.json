{
  "ignorePatterns": ["salvage/**", "dist/**"],
  "rules": {
    "complexity": ["error", { "max": 15 }],
    "max-depth": ["error", { "max": 4 }],
    "max-params": ["error", { "max": 3 }],
    "max-lines": ["error", { "max": 400 }],
    "no-unused-vars": "error",
    "no-console": "error",
    "no-debugger": "error",
    "eqeqeq": "error",
    "prefer-const": "error",
    "no-var": "error"
  },
  "overrides": [
    {
      "files": ["src/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "group": ["**/ui/**"], "message": "Domain must not depend on UI (architectural boundary)" },
            { "group": ["**/app/**"], "message": "Domain must not depend on the app shell (ADR-0003)" },
            { "group": ["**/adapters/**"], "message": "Domain must not depend on adapters (ADR-0016)" }
          ]
        }],
        "no-restricted-globals": ["error", "document", "window", "localStorage", "sessionStorage", "location", "Date", "performance", "crypto", "setTimeout", "setInterval"]
      }
    },
    {
      "files": ["src/app/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "group": ["**/ui/**"], "message": "App shell state must not depend on UI (ADR-0003)" },
            { "group": ["**/adapters/**"], "message": "App shell must not depend on adapters (ADR-0016)" }
          ]
        }],
        "no-restricted-globals": ["error", "localStorage", "sessionStorage"]
      }
    },
    {
      "files": ["src/ui/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "group": ["**/adapters/**"], "message": "UI must not depend on adapters (ADR-0016)" }
          ]
        }],
        "no-restricted-globals": ["error", "localStorage", "sessionStorage"]
      }
    },
    {
      "files": ["src/adapters/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "group": ["**/ui/**"], "message": "Adapters must not depend on UI (ADR-0016)" }
          ]
        }]
      }
    },
    {
      "files": ["tests/**/*.ts", "scripts/**/*.mjs"],
      "rules": { "no-console": "off", "max-lines": "off", "complexity": "off" }
    }
  ]
}
