{
  "name": "gaffer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Mobile-first football management game for the browser. Built unattended by an nWave-governed Claude Code factory.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "ci:lint": "oxlint .",
    "ci:typecheck": "tsc --noEmit",
    "ci:test": "vitest run",
    "ci:build": "vite build",
    "ci:serve": "vite build && vite preview --port 4173 --strictPort",
    "ci:e2e": "playwright test",
    "ci:mutation": "stryker run",
    "check": "pnpm run ci:lint && pnpm run ci:typecheck && pnpm run ci:test && pnpm run ci:build && pnpm run ci:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@types/node": "^22.20.5",
    "fast-check": "^4.6.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0"
  }
}
