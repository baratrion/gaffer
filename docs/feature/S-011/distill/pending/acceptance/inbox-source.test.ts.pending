// @US-1 @US-2 (S-011 read my club's news in the Inbox) held out until DELIVER
// CONTRACT_SHAPE: bounded-change
// Outcome anchor: ADR-0017 Enforcement and ADR-0018 Enforcement; DESIGN DD3, DD4, DD5. Vitest has no DOM, so what cannot be reached by a render is held
// by source checks, as S-009 season-end-source and the S-004 "renderers never move focus" test: (1) inbox.ts (domain) is pure; (2) renderInbox
// emits only Back and moves no focus; (3) one score-line source and one title source shared by the match screen and the Inbox; (4) the club
// home offers Inbox after Table; (5) main.ts renders through a RENDERERS lookup, not a switch; (6) the Inbox code names no storage.
// Destination: tests/acceptance/S-011/inbox-source.test.ts (DELIVER: git mv, dropping .pending, in the commit that adds the screen).
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { describe, expect, it } from "vitest";

const SRC = join(import.meta.dirname, "..", "..", "..", "src");
const read = (...parts: string[]): string => readFileSync(join(SRC, ...parts), "utf8");
const count = (text: string, pattern: RegExp): number => (text.match(pattern) ?? []).length;
const importLines = (text: string): string[] => text.split("\n").filter((line) => /^\s*import\b/.test(line));

describe("@US-1 @US-2 S-011 the report rule stays pure", () => {
  it("Given src/domain/inbox.ts, when searched, then it has no Date, Math.random, Intl, toLocale or storage word, and imports only domain modules @boundary @contract-shape:pure-function", () => {
    const text = read("domain", "inbox.ts");
    expect(text).not.toMatch(/\bDate\b|Math\.random|Intl|toLocale|localStorage|sessionStorage/);
    expect(text).not.toContain("__SCAFFOLD__");
    for (const line of importLines(text)) expect(line).toMatch(/from "\.\/(league|standings)"/);
    expect(text).toContain("standings(");
  });

  it("Given the Inbox's app and UI files, when searched, then none names a storage object or the save module @boundary @contract-shape:bounded-change", () => {
    for (const parts of [["ui", "screens", "inbox.ts"], ["ui", "score-line.ts"]]) expect(read(...parts), parts.join("/")).not.toMatch(/localStorage|sessionStorage|gaffer\.save|app\/save/);
  });
});

describe("@US-1 @US-2 S-011 the Inbox screen emits one action and moves no focus", () => {
  const inboxText = (): string => read("ui", "screens", "inbox.ts");

  it("Given inbox.ts, when searched, then it has one dispatch call (Back) and one listener, no focus call, no innerHTML and no anchor or extra button @boundary @contract-shape:bounded-change", () => {
    const text = inboxText();
    expect(count(text, /\bdispatch\(/g)).toBe(1);
    expect(count(text, /addEventListener\(/g)).toBe(1);
    expect(text).toContain('type: "Back"');
    expect(text).not.toMatch(/\.focus\s*\(|innerHTML|insertAdjacentHTML|el\(\s*"a"/);
    expect(count(text, /el\(\s*"button"/g)).toBe(1);
  });

  it("Given inbox.ts, when searched for the texts Sam reads, then it writes the heading, the list name, the empty line, the position label and Back exactly @boundary @contract-shape:bounded-change", () => {
    const text = inboxText();
    for (const phrase of ["Inbox", "Messages", "No messages yet", "League position", "Back"]) expect(text, phrase).toContain(`"${phrase}"`);
  });
});

describe("@US-1 @US-2 S-011 one score line and one title for the match screen and the Inbox", () => {
  it("Given score-line.ts, match.ts and inbox.ts, when searched, then the builders live in score-line.ts and both screens import them (no copy of the markup) @boundary @contract-shape:bounded-change", () => {
    const shared = read("ui", "score-line.ts");
    expect(shared).toContain("export const scoreLine");
    expect(shared).toContain("export const matchdayTitle");
    expect(shared).toContain('"score-line"');
    for (const file of ["match.ts", "inbox.ts"]) {
      const text = read("ui", "screens", file);
      expect(text, file).toMatch(/from "\.\.\/score-line"/);
      expect(text, `${file} must not rebuild the score markup`).not.toContain("score-goals");
      expect(text, `${file} must not hold its own title template`).not.toMatch(/`Matchday \$\{/);
    }
  });
});

describe("@US-1 S-011 the club home offers Inbox after Table", () => {
  it("Given club-home.ts, when searched, then it offers Inbox through ViewInbox and writes it after Table @boundary @contract-shape:bounded-change", () => {
    const home = read("ui", "screens", "club-home.ts");
    expect(home).toContain('"Inbox"');
    expect(home).toContain("ViewInbox");
    expect(home.indexOf('"Table"')).toBeGreaterThan(-1);
    expect(home.indexOf('"Inbox"')).toBeGreaterThan(home.indexOf('"Table"'));
  });
});

describe("@US-1 S-011 render is a lookup (ADR-0018)", () => {
  it("Given main.ts, when searched, then it holds RENDERERS and no switch on the screen kind @boundary @contract-shape:bounded-change", () => {
    const main = read("main.ts");
    expect(main).toContain("RENDERERS");
    expect(main).not.toMatch(/switch\s*\(/);
    expect(main).toContain("inbox");
  });
});
